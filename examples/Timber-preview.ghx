                <item name="Name" type_name="gh_string" type_code="10">Timber Preview</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="6">
                    <item name="Description" type_name="gh_string" type_code="10">Preview timber on geometry or a Stock Model. Right-click for Textured, Gradient or Force flow on engineered timber. Appearance inspired by Larsson et al. (2022), https://doi.org/10.1145/3528223.3530081.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">76a0e98e-b462-439f-9274-aec8fdfe1ff3</item>
