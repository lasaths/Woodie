                <item name="Name" type_name="gh_string" type_code="10">Timber Preview</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="4">
                    <item name="Description" type_name="gh_string" type_code="10">Preview Rhino geometry as straight or bent timber. Appearance inspired by Larsson et al. (2022), Procedural Texturing of Solid Wood with Knots. ACM Transactions on Graphics 41(4), Article 45 (SIGGRAPH 2022). https://doi.org/10.1145/3528223.3530081. Cut-aware procedural detail informed by Larsson et al. (2024), https://doi.org/10.1111/cgf.15074, and Mokume (2025), https://doi.org/10.1145/3730874; independent adaptation.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">67707964-fb1b-450a-abf7-2fd9caea1370</item>
                    <item name="Name" type_name="gh_string" type_code="10">Timber Preview</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Plywood / 10 Bowed extrusion - guide</item>
                  </items>
                  <chunks count="13">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                          <X>0</X>
                          <Y>0</Y>
                          <W>150</W>
                          <H>20</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>2060</X>
                          <Y>4310</Y>
                        </item>
                      </items>
                    </chunk>
                    <chunk name="param_input" index="0">
                      <items count="7">
                        <item name="Description" type_name="gh_string" type_code="10">Mesh, Brep, Surface or Extrusion; input geometry is unchanged</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">ce8c4802-39d2-4784-8ddd-342241e04792</item>
                        <item name="Name" type_name="gh_string" type_code="10">Geometry</item>
                        <item name="NickName" type_name="gh_string" type_code="10">G</item>
